# Gateway settings for the Pi. install.sh copies this to /etc/ccm/ccm.env.
# Every CCM_* variable read by gateway/src/ccm_gateway/config.py.
CCM_DB=/var/lib/ccm/ccm.sqlite3
CCM_MQTT_HOST=127.0.0.1
CCM_MQTT_PORT=1883
CCM_API_HOST=0.0.0.0
CCM_API_PORT=8000
CCM_DASHBOARD_DIST=/opt/ccm/dashboard/dist
CCM_RAW_RETENTION_DAYS=7
CCM_UPLINK_URL=
CCM_UPLINK_KEY=
CCM_UPLINK_PERIOD_S=10
