[Unit]
Description=CCM gateway MQTT ingest
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=ccm
Group=ccm
EnvironmentFile=/etc/ccm/ccm.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/var/lib/ccm
ExecStart=/opt/ccm/venv/bin/ccm-gateway ingest
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
