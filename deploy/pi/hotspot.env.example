# WiFi hotspot for the Crew Context Monitor, read by hotspot.sh.
# Copy this file to /etc/ccm/hotspot.env and fill in your own values.
# Never commit real credentials.
CCM_HOTSPOT_SSID="ccm-pi"
CCM_HOTSPOT_PASSWORD="change-me-please"
CCM_HOTSPOT_IFACE="wlan0"
CCM_HOTSPOT_ADDRESS="192.168.4.1/24"
CCM_HOTSPOT_CONNECTION="ccm-hotspot"
