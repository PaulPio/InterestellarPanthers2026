{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd dashboard && npm ci && npm run build",
  "outputDirectory": "dashboard/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{sim/src/**,sim/scenarios/**,sim/params/**,contracts/**,cloud/ccm_cloud/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
